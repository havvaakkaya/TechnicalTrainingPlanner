@model TechnicalTrainingPlanner.ViewModels.Sessions.SessionsIndexViewModel
@{
    ViewData["Title"] = "Oturumlar";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Oturumlar</h1>
        <p class="text-muted mb-0">Önceden tanımlanmış eğitim oturumları · Saat dilimi: İstanbul</p>
    </div>
    <a asp-controller="Sessions" asp-action="Create" class="btn btn-primary">Yeni oturum</a>
</div>

<form asp-controller="Sessions" asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label asp-for="TrainingId" class="form-label">Eğitim</label>
        <select asp-for="TrainingId" asp-items="Model.Trainings" class="form-select">
            <option value="">Tüm eğitimler</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label">Durum</label>
        <select asp-for="Status" class="form-select">
            <option value="">Tümü</option>
            <option value="PLANNED">Planlı</option>
            <option value="CANCELLED">İptal</option>
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Filtrele</button></div>
</form>

<div class="table-responsive planner-scroll-list">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr><th scope="col">Sıra</th><th>Tarih ve saat (İstanbul)</th><th>Eğitim</th><th>Eğitmen</th><th>Sınıf / konum</th><th>Kontenjan</th><th>Durum</th><th></th></tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Sessions.Count; i++)
        {
            var item = Model.Sessions[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@item.StartsAtLocal.ToString("dd.MM.yyyy HH:mm") – @item.EndsAtLocal.ToString("HH:mm")</td>
                <td>@item.TrainingCode · @item.TrainingName</td>
                <td>@item.InstructorCode</td>
                <td>@item.ClassroomCode / @item.LocationCode</td>
                <td>@item.Capacity</td>
                <td>@(item.Status == "PLANNED" ? "Planlı" : "İptal")</td>
                <td><a asp-controller="Sessions" asp-action="Details" asp-route-id="@item.Id">Detay</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Sessions.Count == 0)
{
    <p class="text-muted">Bu filtrelere uygun oturum bulunamadı.</p>
}
