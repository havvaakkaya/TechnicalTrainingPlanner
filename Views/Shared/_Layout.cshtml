@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Teknik Eğitim Planlayıcı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/planner-ui.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid px-3">
                <a class="navbar-brand planner-brand" asp-controller="Dashboard" asp-action="Index">TT Planner</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#plannerNavigation"
                        aria-controls="plannerNavigation" aria-expanded="false" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="plannerNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @(activeController == "Dashboard" ? "planner-nav-active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Employees" ? "planner-nav-active" : "")" asp-controller="Employees" asp-action="Index">Çalışanlar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Trainings" ? "planner-nav-active" : "")" asp-controller="Trainings" asp-action="Index">Eğitimler</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Sessions" ? "planner-nav-active" : "")" asp-controller="Sessions" asp-action="Index">Oturumlar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Needs" ? "planner-nav-active" : "")" asp-controller="Needs" asp-action="Index">İhtiyaçlar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Planning" ? "planner-nav-active" : "")" asp-controller="Planning" asp-action="Index">Planlama</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Calendar" ? "planner-nav-active" : "")" asp-controller="Calendar" asp-action="Index">Takvim</a></li>
                        <li class="nav-item"><a class="nav-link @(activeController == "Reports" ? "planner-nav-active" : "")" asp-controller="Reports" asp-action="Index">Raporlar</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-3">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>
    <footer class="border-top text-muted py-3 mt-4">
        <div class="container-fluid px-3">Teknik Eğitim Planlayıcı · Kurgusal pilot veri</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
