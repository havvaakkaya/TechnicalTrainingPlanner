@model TechnicalTrainingPlanner.ViewModels.Employees.EmployeesIndexViewModel
@{
    ViewData["Title"] = "Çalışanlar";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Çalışanlar</h1>
        <p class="text-muted mb-0">Sentetik pilot veriler · @Model.Employees.Count aktif çalışan</p>
    </div>
    <a asp-controller="Employees" asp-action="Create" class="btn btn-primary">Yeni çalışan</a>
</div>

<form asp-controller="Employees" asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">Birim</label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
            <option value="">Tüm birimler</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="JobRoleId" class="form-label">Görev rolü</label>
        <select asp-for="JobRoleId" asp-items="Model.JobRoles" class="form-select">
            <option value="">Tüm roller</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="StatusCode" class="form-label">Personel statüsü</label>
        <select asp-for="StatusCode" asp-items="Model.Statuses" class="form-select">
            <option value="">Tüm statüler</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Ara</button>
    </div>
</form>

<div class="table-responsive planner-scroll-list">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr><th>Kod</th><th>Çalışan</th><th>Birim</th><th>Görev rolü</th><th>Statü</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Employees)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.DisplayName</td>
                <td>@item.DepartmentName</td>
                <td>@item.JobRoleName</td>
                <td>@item.PersonnelStatuses</td>
                <td><a asp-controller="Employees" asp-action="Details" asp-route-id="@item.Id">Detay</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Employees.Count == 0)
{
    <p class="text-muted">Seçilen filtrelere uygun çalışan bulunamadı.</p>
}
