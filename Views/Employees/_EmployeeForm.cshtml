@model TechnicalTrainingPlanner.ViewModels.Employees.EmployeeFormViewModel

<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label">Çalışan kodu</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="DisplayName" class="form-label">Çalışan adı</label>
        <input asp-for="DisplayName" class="form-control" />
        <span asp-validation-for="DisplayName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DepartmentId" class="form-label">Birim</label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
            <option value="0">Birim seçiniz</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="JobRoleId" class="form-label">Görev rolü</label>
        <select asp-for="JobRoleId" asp-items="Model.JobRoles" class="form-select">
            <option value="0">Görev rolü seçiniz</option>
        </select>
        <span asp-validation-for="JobRoleId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <fieldset class="border rounded p-3">
            <legend class="float-none w-auto px-2 fs-6">Personel statüsü</legend>
            <p class="text-muted small">Görev rolünden ayrı seçilir. Uygun statü yoksa boş bırakılabilir.</p>
            @foreach (var status in Model.Statuses)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedStatusCodes" value="@status.Value"
                           id="status_@status.Value"
                           checked="@Model.SelectedStatusCodes.Contains(status.Value)" />
                    <label class="form-check-label" for="status_@status.Value">@status.Text</label>
                </div>
            }
        </fieldset>
    </div>
    <div class="col-12 form-check ms-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Aktif çalışan</label>
    </div>
</div>
<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</div>
